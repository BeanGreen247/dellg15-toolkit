  },
  "GameModeMangoHud": {
    "Content": "GameMode + MangoHud",
    "Description": "Per-game CPU/GPU perf profile + FPS/frametime overlay. Launch with: gamemoderun mangohud %command%",
    "category": "Software",
    "manager": "dnf",
    "package": "gamemode mangohud",
    "check": "rpm -q gamemode mangohud >/dev/null 2>&1",
    "install": ["dnf install -y gamemode mangohud", "usermod -aG gamemode {USER}"]
  },
  "GOverlay": {
    "Content": "GOverlay",
