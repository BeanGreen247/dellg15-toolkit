    "manager": "shell",
    "check": "rpm -q lm_sensors >/dev/null 2>&1",
    "install": ["dnf install -y lm_sensors", "yes | sensors-detect --auto >/dev/null 2>&1 || true"]
  },
  "Fastfetch": {
